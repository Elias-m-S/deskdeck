# ESP32-S3 SuperMini (ESP32-S3FH4R2: 4 MB flash, 2 MB quad PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# USB belongs to TinyUSB (USB-OTG) from now on, not to USB-Serial/JTAG.
# Boot logs go to UART0 (TX = GPIO43); afterwards the app redirects
# stdout/ESP_LOG to the CDC interface -> /dev/ttyACM0.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# TinyUSB: 1x HID (keyboard + consumer control), 1x CDC (log console)
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1

# Wi-Fi + MQTT need more than 1 MB (NVS stays at the same place)
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
