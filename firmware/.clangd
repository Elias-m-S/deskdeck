# clangd uses the compile_commands.json generated by idf.py.
# Strip the Xtensa GCC specific flags that clang does not know.
CompileFlags:
  CompilationDatabase: build
  Remove:
    - -mlongcalls
    - -mdisable-hardware-atomics
    - -fno-tree-switch-conversion
    - -fstrict-volatile-bitfields
    - -fno-shrink-wrap
    - -fzero-init-padding-bits=*
    - -specs=*
    - -march=*
    - -mabi=*
Diagnostics:
  UnusedIncludes: None
